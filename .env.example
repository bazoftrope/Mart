# PostgreSQL connection
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/marathon_platform

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production

# Admin credentials
# Первый вход: используйте эти данные на странице /login
# Для генерации хеша: node -e "console.log(require('bcrypt').hashSync('ваш_пароль', 10))"
# Важно: экранируй $ в хеше обратным слэшем: \$2b\$10\$...
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=\$2b\$10\$replace-with-real-bcrypt-hash

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Загруженные аудиофайлы марафонов (локальное хранилище)
# По умолчанию: <project>/data/uploads/audio
UPLOAD_DIR=./data/uploads/audio
